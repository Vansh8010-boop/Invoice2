# From Supabase → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co/rest/v1/
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Note: the browser-facing anon key is NOT set here — it goes directly into
# index.html (see the SUPABASE_URL / SUPABASE_ANON_KEY constants near the
# top of the <script> block), since it's meant to be public and the page
# has no build step to inject env vars into.
